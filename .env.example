# Copy to .env.local (gitignored) and fill in. Never commit real values.

# --- API auth ---
# If set, every request to the FastAPI service must send a matching
# X-API-Key header. Unset for frictionless local dev; set before exposing
# the API over a tunnel or any public network.
ECHOVERSE_API_KEY=

# --- TTS engine selection ---
# "piper" (default): local, free forever, no key needed.
# "elevenlabs": real emotional prosody, free 10k-characters/month tier.
TTS_ENGINE=piper

# --- ElevenLabs (only needed if TTS_ENGINE=elevenlabs) ---
# Get a key at elevenlabs.io -> Profile -> API Keys. Scope it to
# Text-to-Speech (required) and Voices: Read (optional, only needed if
# you want to list your account's available voices via the API).
ELEVENLABS_API_KEY=

# Optional voice ID overrides. Defaults are two of the ~20 premade voices
# every account gets ("George" narrator / "Sarah" dialogue) -- free tier
# can ONLY use voices already in your account, not the shared community
# voice library (that returns a 402 payment_required error).
ELEVENLABS_VOICE_ID=
ELEVENLABS_NARRATOR_VOICE_ID=
ELEVENLABS_DIALOGUE_VOICE_ID=

# --- Ollama ---
# Only needed if pointing at a non-default Ollama host, e.g. the
# container-network hostname used in docker-compose.yml.
OLLAMA_HOST=
